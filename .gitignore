# Instruction/memory repo: track markdown broadly; keep heavy local artifacts out.

.DS_Store
.claude/

# Caches / local tooling
**/.pytest_cache/
**/__pycache__/
**/.mypy_cache/
**/.ruff_cache/
**/node_modules/

# Local non-markdown workspaces and artifacts
jobs/
patches/
1/

# Local binaries / archives / screenshots
*.tar.gz
*.png
*.jpg
*.jpeg
*.webp

# Nested git metadata must never be committed as gitlinks
**/.git/

# Ignore non-markdown content under task folders by default
dynamo-/**
!dynamo-/**/
!dynamo-/**/*.md
!dynamo-/**/*.MD
!dynamo-/**/*.markdown

# Still ignore cache READMEs under task folders
dynamo-/**/.pytest_cache/
